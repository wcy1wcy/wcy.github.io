---
import Base from './Base.astro';
import Serpent from '../components/Serpent.astro';
import Volume from '../components/Volume.astro';
import { fmtDate } from '../lib/format';

interface Props {
  kind: 'blog' | 'life';
  title: string;
  description?: string;
  date: Date;
  minutes: number;
  tags: string[];
  location?: string;
  volume?: number; // 有 volume 的日常文章就是吼叫信
  kicker?: string;
  cover?: string;
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
}
const { kind, title, description, date, minutes, tags, location, volume, kicker, cover, prev, next } = Astro.props;
const howler = kind === 'life' && !!volume;
const back =
  kind === 'blog'
    ? { href: '/blog/', label: 'The Gazette · 博客' }
    : howler
      ? { href: '/life/#howlers', label: 'Howlers · 吼叫信' }
      : { href: '/life/', label: 'The Pensieve · 日常' };
---
<Base title={title} description={description} bodyClass={howler ? 'page-rants' : ''}>
  <article>
    <header class="post-head">
      <a class="eyebrow" href={back.href}><em>{back.label}</em>{kicker && <span class="kicker"> — {kicker}</span>}</a>
      <h1 class:list={['post-title', { shake: howler && volume === 3 }]}>{title}</h1>
      {kind === 'blog' && description && <p class="post-dek">{description}</p>}
      <div class="post-meta">
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        <span class="brew">熬制时间 · <em>{minutes} min brew</em></span>
        {location && <span>{location}</span>}
        {howler && <span>volume<Volume level={volume!} /></span>}
      </div>
      {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
    </header>
    {cover && <img class="post-cover" src={cover} alt="" />}
    <div class="prose">
      <slot />
    </div>
    <Serpent />
    <nav class="post-nav" aria-label="More posts">
      {prev && <a href={prev.href}><small>← Newer</small><span>{prev.title}</span></a>}
      {next && <a class="next" href={next.href}><small>Older →</small><span>{next.title}</span></a>}
    </nav>
  </article>
</Base>
