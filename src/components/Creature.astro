---
// 原创的小插画：幽灵、神奇生物、守护神。颜色跟随主题。
interface Props {
  kind: 'ghost' | 'niffler' | 'owl' | 'squid' | 'acromantula' | 'basilisk' | 'thestral' | 'hare';
  size?: number;
  class?: string;
}
const { kind, size = 48, class: cls = '' } = Astro.props;
---
{kind === 'ghost' && (
  <svg class:list={['creature', 'c-ghost', cls]} width={size} height={size * 1.3} viewBox="0 0 60 78" aria-hidden="true">
    <path class="ghost-sheet" d="M30 3C15 3 8 15 8 29v29c0 6 4 11 8 7 3-3 5 6 10 4 4-2 4 6 9 2 4-3 6 4 10-2 4-6 7-4 7-11V29C52 15 45 3 30 3z" />
    <path class="ghost-arm" d="M9 38c-5 2-7 6-6 10M51 38c5 2 7 6 6 10" />
    <ellipse class="ghost-eye" cx="23" cy="27" rx="2.4" ry="3.4" />
    <ellipse class="ghost-eye" cx="37" cy="27" rx="2.4" ry="3.4" />
    <ellipse class="ghost-eye" cx="30" cy="38" rx="2.6" ry="3.2" opacity=".7" />
  </svg>
)}
{kind === 'niffler' && (
  <svg class:list={['creature', 'c-niffler', cls]} width={size} height={size * 0.875} viewBox="0 0 64 56" aria-hidden="true">
    <circle cx="16" cy="18" r="5" class="fur" />
    <circle cx="48" cy="18" r="5" class="fur" />
    <ellipse cx="32" cy="34" rx="21" ry="18" class="fur" />
    <ellipse cx="32" cy="31" rx="8" ry="4" class="snout" />
    <circle cx="24" cy="23" r="2" class="shine" />
    <circle cx="40" cy="23" r="2" class="shine" />
    <ellipse cx="20" cy="49" rx="5" ry="3" class="paw" />
    <ellipse cx="44" cy="49" rx="5" ry="3" class="paw" />
    <circle cx="47" cy="44" r="5.5" class="coin" />
    <path d="M45 44h4" class="coin-mark" />
  </svg>
)}
{kind === 'owl' && (
  <svg class:list={['creature', 'c-owl', cls]} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
    <path class="owl-body" d="M12 14l3-7 5 5h8l5-5 3 7c3 4 4 9 4 14 0 9-7 16-16 16S8 37 8 28c0-5 1-10 4-14z" />
    <circle cx="18" cy="21" r="5.2" class="owl-eye" /><circle cx="30" cy="21" r="5.2" class="owl-eye" />
    <circle cx="18" cy="21" r="2" class="owl-pupil" /><circle cx="30" cy="21" r="2" class="owl-pupil" />
    <path d="M22.5 26l1.5 3 1.5-3z" class="owl-beak" />
    <path d="M14 33c3 3 7 4 10 4s7-1 10-4" class="owl-line" />
  </svg>
)}
{kind === 'squid' && (
  <svg class:list={['creature', 'c-squid', cls]} width={size * 1.6} height={size} viewBox="0 0 200 120" aria-hidden="true">
    <path d="M6 60l18-16v32z" />
    <path d="M18 60C40 32 104 36 128 60 104 84 40 88 18 60z" />
    <g fill="none" stroke-linecap="round">
      <path d="M126 54c20-10 34 4 50-6s18-2 20 2" stroke-width="5" />
      <path d="M128 58c22-2 30 10 48 6" stroke-width="4" />
      <path d="M128 62c18 6 28 20 46 16" stroke-width="4" />
      <path d="M126 66c14 14 20 28 40 30" stroke-width="3" />
      <path d="M124 50c12-14 24-22 44-20" stroke-width="3" />
    </g>
  </svg>
)}
{kind === 'acromantula' && (
  <svg class:list={['creature', 'c-eyes', cls]} width={size} height={size * 0.5} viewBox="0 0 40 20" aria-hidden="true">
    <circle cx="16" cy="10" r="3" /><circle cx="24" cy="10" r="3" />
    <circle cx="11" cy="7" r="1.6" /><circle cx="29" cy="7" r="1.6" />
    <circle cx="8" cy="12" r="1.3" /><circle cx="32" cy="12" r="1.3" />
    <circle cx="13" cy="15" r="1.1" /><circle cx="27" cy="15" r="1.1" />
  </svg>
)}
{kind === 'basilisk' && (
  <svg class:list={['creature', 'c-basilisk', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M15.5 5.2C9 3.6 5.2 7.4 8.6 10.6s8.3 3.4 7.4 7.1c-.8 3.2-6 3.5-10 1.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
    <ellipse cx="17.6" cy="5.6" rx="2.6" ry="1.9" transform="rotate(12 17.6 5.6)" fill="currentColor" />
  </svg>
)}
{kind === 'thestral' && (
  <svg class:list={['creature', 'c-thestral', cls]} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
    <rect x="4" y="4" width="40" height="40" rx="8" fill="none" stroke="currentColor" stroke-dasharray="3 4" opacity=".45" />
  </svg>
)}
{kind === 'hare' && (
  <svg class:list={['creature', 'c-hare', cls]} width={size * 1.7} height={size} viewBox="0 0 120 70" aria-hidden="true">
    <ellipse cx="84" cy="13" rx="4" ry="14" transform="rotate(-28 84 13)" />
    <ellipse cx="91" cy="11" rx="3.6" ry="13" transform="rotate(-12 91 11)" />
    <circle cx="93" cy="31" r="11" />
    <ellipse cx="60" cy="43" rx="30" ry="15" />
    <ellipse cx="40" cy="53" rx="15" ry="8" transform="rotate(-18 40 53)" />
    <circle cx="29" cy="37" r="6" />
    <path d="M82 50l10 13M74 52l4 13" stroke-width="5" stroke-linecap="round" class="hare-leg" />
  </svg>
)}
